{
  "name": "logseq-furigana-ruby",
  "version": "0.8.3",
  "description": "Logseq plugin that renders [base]^^(ruby) Inline Annotation syntax for ruby/furigana and glosses.",
  "main": "dist/index.html",
  "author": "Baksi Li <myself@baksili.codes>",
  "repository": {
    "type": "git",
