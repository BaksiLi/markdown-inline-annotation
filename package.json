{
  "name": "markdown-inline-annotation",
  "version": "0.8.4",
  "private": true,
  "description": "The Inline Annotation specification, conformance corpus, and editor integrations.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "node scripts/tasks.mjs build",
    "test": "node scripts/tasks.mjs test",
    "lint:tests": "oxlint packages plugins scripts",
    "check": "npm run lint:tests && node scripts/tasks.mjs check",
    "examples:sync": "node scripts/sync-showcase.mjs && npm run build:examples --workspace packages/markdown-it",
    "release:prepare": "node scripts/version.mjs",
    "release:pack": "node scripts/package.mjs",
    "release:verify": "node scripts/verify-artifacts.mjs",
    "release:publish": "node scripts/publish.mjs",
    "release:status": "node scripts/migration-status.mjs"
  },
  "devDependencies": {
    "@interfere/landmines": "0.1.1",
    "@vscode/vsce": "4.1.1",
    "oxlint": "1.94.0"
  }
}
