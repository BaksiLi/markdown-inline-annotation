{
  "name": "vscode-inline-annotation",
  "displayName": "Inline Annotation",
  "description": "Render Inline Annotation syntax in VS Code's built-in Markdown preview.",
  "version": "0.2.0",
  "publisher": "baksili",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown-it",
    "ruby",
    "furigana",
    "inline-annotation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaksiLi/vscode-inline-annotation.git"
  },
  "homepage": "https://github.com/BaksiLi/vscode-inline-annotation#readme",
  "bugs": {
    "url": "https://github.com/BaksiLi/vscode-inline-annotation/issues"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node test/preview.test.mjs",
    "check": "npm test && node scripts/check-package.mjs",
    "check:local": "npm install --no-save file:../markdown-it-inline-annotation && npm run check",
    "package": "npx @vscode/vsce package",
    "publish:marketplace": "npx @vscode/vsce publish"
  },
  "dependencies": {
    "markdown-it-inline-annotation": "^0.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.0.0",
    "markdown-it": "^14.0.0",
    "typescript": "^5.0.0"
  }
}
