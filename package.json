{
  "name": "satteri-inline-annotation",
  "version": "0.1.0",
  "description": "Satteri adapter for the Inline Annotation syntax and canonical renderer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test && npm pack --dry-run"
  },
  "keywords": [
    "satteri",
    "markdown",
    "inline-annotation",
    "ruby",
    "furigana",
    "bouten"
  ],
  "author": "Baksi Li",
  "license": "MIT",
  "dependencies": {
    "markdown-it-inline-annotation": "^0.3.3"
  },
  "peerDependencies": {
    "satteri": ">=0.9.5 <1"
  },
  "devDependencies": {
    "satteri": "0.9.5",
    "typescript": "^5.0.0"
  }
}
