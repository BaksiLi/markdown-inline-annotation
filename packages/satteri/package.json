{
  "name": "satteri-inline-annotation",
  "version": "0.8.4",
  "description": "Satteri adapter for the Inline Annotation syntax and canonical renderer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "satteri",
    "markdown",
    "inline-annotation",
    "ruby",
    "furigana",
    "bouten"
  ],
  "author": "Baksi Li",
  "license": "MIT",
  "dependencies": {
    "markdown-it-inline-annotation": "^0.8.4"
  },
  "peerDependencies": {
    "satteri": ">=0.9.5 <1"
  },
  "devDependencies": {
    "satteri": "0.9.5",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaksiLi/markdown-inline-annotation.git",
    "directory": "packages/satteri"
  },
  "homepage": "https://github.com/BaksiLi/markdown-inline-annotation/tree/main/packages/satteri#readme",
  "bugs": {
    "url": "https://github.com/BaksiLi/markdown-inline-annotation/issues"
  },
  "private": true
}
